# ═══════════════════════════════════════════════════════════════
# Example flow configuration for the charm bulk workflow
# ═══════════════════════════════════════════════════════════════
# Copy this file, edit paths to match your data, and point
# charmbulk_workflow.ipynb → CONFIG_PATH to it.

operations:
    make_yaml: true                # Step 1: Generate cutset YAML files
    mass_fit: true                 # Step 2: Fit mass distributions (flarefly)
    cut_variation: true            # Step 3: Corrected yields via minimisation
    data_driven_fraction: true     # Step 4: Prompt/FD fractions

outdir: '/path/to/your/output'    # Base output directory
suffix: 'my_analysis'             # Suffix for the output folder name
centrality: 'k010'                # Centrality class (e.g., k010, k3050)
Dmeson: 'Dzero'                   # D meson species (Dzero, Dplus, Ds)

# pT bins
ptbins: [1.0, 2.0, 2.5, 3.0, 3.5, 4.0, 5.0, 6.0, 8.0, 12.0]

# Optional: custom input paths for data that's already been processed
# If empty, auto-detects from outdir:
#   projs → {outdir}/cutvar_{suffix}_correlated/projs
#   effs  → {outdir}/cutvar_{suffix}_correlated/effs
inputs:
    projs: ''         # Path to directory with proj_*.root files
    raw_yields: ''    # Path to directory with raw_yields_*.root files
    effs: ''          # Path to directory with eff_*.root files

# ── Cut variation configuration ────────────────────────────
cut_variation:
    # Correlated: same BDT cut index across all pT bins
    corr_bdt_cut:
        bkg_max: [0.01, 0.01, 0.01, 0.01, 0.02, 0.02, 0.03, 0.06, 0.1]
        sig:
            min: [0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.1]
            max: [0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99]
            step: [0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04]
    # Uncorrelated: independent BDT cuts per pT bin
    uncorr_bdt_cut:
        bkg_max: []
        sig: []

# ── Projection configuration ───────────────────────────────
projections:
    # Invariant mass bin edges per pT bin
    inv_mass_bins:
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.02]
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.02]
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.02]
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.02]
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.02]
        - [1.72, 1.78, 1.84, 1.90, 1.96, 2.04]
        - [1.70, 1.76, 1.82, 1.90, 1.98, 2.04]
        - [1.68, 1.74, 1.82, 1.90, 1.98, 2.06]
        - [1.66, 1.74, 1.84, 1.94, 2.04, 2.08]

# ── v2 extraction (mass fit) configuration ─────────────────
v2extraction:
    Sigma: [0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02]
    MassFitRanges:
        - [1.72, 2.02]   # pT bin 1
        - [1.72, 2.02]   # pT bin 2
        - [1.72, 2.02]   # pT bin 3
        - [1.72, 2.02]   # pT bin 4
        - [1.72, 2.02]   # pT bin 5
        - [1.72, 2.04]   # pT bin 6
        - [1.70, 2.04]   # pT bin 7
        - [1.68, 2.06]   # pT bin 8
        - [1.66, 2.08]   # pT bin 9
    BkgFunc: 'kExpo'       # Background function
    SgnFunc: 'kGaus'       # Signal function
    Rebin: [2, 2, 2, 2, 2, 4, 4, 5, 6]  # Rebin factor per pT bin
